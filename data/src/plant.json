  "sis": {
    "en": "Safety instrumented system",
    "ar": "نظام السلامة المزود بالأجهزة",
    "abbr": "SIS",
    "esd_en": "Emergency shutdown",
    "esd_ar": "الإيقاف الطارئ",
    "guards": [
      "hp_pressure",
      "cl2_residual"
    ],
    "desc": {
      "en": "The safety system watches the high-pressure discharge and the chlorine residual, and on a high reading it trips an emergency shutdown that stops the high-pressure pumps, isolates the dosing and diverts off-spec water to waste so it never reaches the network.",
      "ar": "يراقب نظام السلامة ضغط الطرد العالي والكلور المتبقي وعند ارتفاع القراءة يشغّل إيقافًا طارئًا يوقف مضخات الضغط العالي ويعزل الجرعات ويحوّل الماء المخالف للمواصفة إلى الصرف حتى لا يصل إلى الشبكة."
    }
  }
