{
  "name": "dir",
  "version": "1.0.0",
  "description": "Dir' is an open source seawater desalination plant cyber range for Saudi Arabia, with a live process simulation, defensive controls mapped to IEC 62443 and the NCA OT controls, MITRE ATT&CK for ICS attack paths and NCA incident playbooks, plus an MCP server.",
  "type": "module",
  "bin": { "dir": "mcp/server.mjs" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test",
    "preflight": "node scripts/preflight.mjs",
    "mcp": "node mcp/server.mjs",
    "selftest": "node mcp/server.mjs --selftest",
    "start": "node mcp/server.mjs"
  },
  "files": ["docs/", "mcp/", "scripts/", "LICENSE", "README.md", "NOTICE.md"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "author": "Ali AlEnezi",
  "homepage": "https://dir.3li.info/",
  "repository": { "type": "git", "url": "https://github.com/SiteQ8/Dir.git" },
  "keywords": ["ics", "ot", "cyber-range", "iec-62443", "otcc", "nca", "mitre-attack", "desalination", "saudi-arabia", "mcp"]
}
